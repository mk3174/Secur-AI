# SecurAI API configuration (copy to .env). All vars are prefixed SECURAI_.

# App
SECURAI_ENVIRONMENT=local
SECURAI_DEBUG=false

# Database (SQLite for local dev; Postgres in prod)
SECURAI_DATABASE_URL=sqlite+aiosqlite:///./securai.db
# SECURAI_DATABASE_URL=postgresql+asyncpg://securai:securai@localhost:5432/securai

# Security — CHANGE THESE IN PRODUCTION
SECURAI_JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
SECURAI_JWT_ACCESS_TTL_SECONDS=3600

# Bootstrap admin (first run only)
SECURAI_BOOTSTRAP_ENABLED=true
SECURAI_BOOTSTRAP_ADMIN_EMAIL=admin@securai.local
SECURAI_BOOTSTRAP_ADMIN_PASSWORD=admin12345

# LLM provider: "echo" (mock) or "openai_compatible" (vLLM / OpenAI-compatible)
SECURAI_DEFAULT_PROVIDER=echo
SECURAI_DEFAULT_MODEL=securai-echo-1
# For a local vLLM server:
# SECURAI_DEFAULT_PROVIDER=openai_compatible
# SECURAI_DEFAULT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# SECURAI_PROVIDER_BASE_URL=http://vllm:8000/v1
# SECURAI_PROVIDER_API_KEY=

# Rate limiting
SECURAI_RATE_LIMIT_ENABLED=true
SECURAI_RATE_LIMIT_PER_MINUTE=120

# Logging
SECURAI_LOG_LEVEL=INFO
SECURAI_LOG_JSON=true
